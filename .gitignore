# ===========================================================
# .gitignore — AD Attack Lab
# Objectif sécu : ne JAMAIS committer de secrets ni de données
# de lab réutilisables hors contexte.
# ===========================================================

# --- Secrets & identifiants (CRITIQUE) ---
*.env
.env*
*.pem
*.key
*.ppk
*.pfx
*.p12
id_rsa*
*.kirbi            # tickets Kerberos
*.ccache           # cache de tickets
*.ntds             # extraits de base AD
ntds.dit
*.secrets
secrets.*
credentials*
*_creds*

# --- Hashes & sorties d'outils potentiellement sensibles ---
*.hash
hashes.txt
*.pot              # sorties hashcat/john
*.potfile
loot/
dumps/

# --- Fichiers de capture réseau ---
*.pcap
*.pcapng
*.cap

# --- Artefacts VM / gros binaires (ne vont pas sur Git) ---
*.vdi
*.vmdk
*.ova
*.iso
*.qcow2

# --- Système / éditeurs ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~

# --- Python (si scripts d'analyse) ---
__pycache__/
*.pyc
.venv/
venv/
